@@ -0,0 +1,74 @@
+// UCI over WASI: the UCI loop's side of the poll helper (internal/uciwasi). A
+// wasip1 build has one thread and no preemption, so the search runs on the UCI
+// loop's goroutine, and what a poll hears does what Execute does for the same
+// command, without the channel waits that would block the only goroutine.
+
+package main
+
+import (
+	"io"
+	"runtime"
+
+	"bitbucket.org/zurichess/zurichess/engine"
+	"bitbucket.org/zurichess/zurichess/internal/uciwasi"
+)
+
+// maxHashMB is Hash's maximum: a 32-bit address space.
+const maxHashMB = 1024
+
+// stdin gives the helper's lines to the UCI loop's scanner.
+var stdin io.Reader = &lineReader{}
+
+type lineReader struct{ pending []byte }
+
+func (r *lineReader) Read(p []byte) (int, error) {
+	if len(r.pending) == 0 {
+		line, ok := uciwasi.Getline()
+		if !ok {
+			return 0, io.EOF
+		}
+		r.pending = append(append(r.pending, line...), '\n')
+	}
+	n := copy(p, r.pending)
+	r.pending = r.pending[:copy(r.pending, r.pending[n:])]
+	return n, nil
+}
+
+// start runs the search where go_ started its goroutine.
+func (uci *UCI) start() {
+	engine.PollInput = func(unbounded bool) { uci.heard(uciwasi.Poll(unbounded)) }
+	uci.play()
+}
+
+// heard does what ponderhit and stop do: ponderhit ends pondering, and stop ends the search and pondering.
+func (uci *UCI) heard(bits int) {
+	if bits&uciwasi.Ponderhit != 0 {
+		uci.timeControl.PonderHit()
+		select {
+		case <-uci.ponder:
+		default:
+		}
+	}
+	if bits&uciwasi.Stop != 0 {
+		uci.timeControl.Stop()
+		select {
+		case <-uci.ponder:
+		default:
+		}
+	}
+}
+
+// waitPonder waits on input while a finished ponder search still ponders.
+func (uci *UCI) waitPonder() {
+	for len(uci.ponder) == cap(uci.ponder) {
+		uci.heard(uciwasi.Wait())
+	}
+}
+
+// freeHash frees the hash table before a new one is made. A wasm memory never
+// shrinks, and Go's next collection comes only after the new table is made, so
+// each Hash change would otherwise grow memory by the new table's size.
+func freeHash() {
+	engine.GlobalHashTable = nil
+	runtime.GC()
+}
