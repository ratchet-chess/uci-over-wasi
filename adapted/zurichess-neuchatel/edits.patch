+// UCI over WASI: the search's side of the poll helper. The UCI loop sets
+// PollInput (zurichess/uci_wasi_wasip1.go), and the search's periodic check
+// (Stopped, every checkpointStep nodes) calls it.
+
+package engine
+
+// PollInput reads the input that waits and acts on it; unbounded is whether only a stop ends the search. Nil outside a UCI loop.
+var PollInput func(unbounded bool)
+
+// poll calls PollInput. Only a stop ends a search that still ponders, or one
+// with no time for the side to move and no depth limit short of Play's last
+// depth (go infinite); this patch's reading of TimeControl.
+func (tc *TimeControl) poll() {
+	if PollInput != nil {
+		PollInput(!tc.ponderhit.get() || tc.time >= infinite && tc.Depth >= 63)
+	}
+}
