 bool Search::ShouldAbort(const ThreadData& t) {
+#ifdef __wasi__
+	// UCI over WASI: the search hears its input here, every 1024 nodes, as the time check reads the clock.
+	if (t.IsMainThread() && !t.singlethreaded && t.Nodes % 1024 == 0) {
+		const bool unbounded = Constraints.MaxDepth == -1 && Constraints.MaxNodes == -1
+			&& Constraints.SoftNodes == -1 && Constraints.SearchTimeMax == -1;
+		if (uci_poll(unbounded) & UCI_STOP) Aborting.store(true, std::memory_order_relaxed);
+	}
+#endif
