+
+/// UCI over WASI: the pinned toolchain's WebAssembly SIMD returns the bitmask of a mask with more than 16 lanes with
+/// its 16-lane groups in reverse order, so a module builds that bitmask from 16-lane groups, which it returns right.
+#[cfg(target_os = "wasi")]
+#[inline(always)]
+pub fn wasi_bitmask<T: MaskElement, const N: usize>(mask: Mask<T, N>) -> u64 {
+    if N <= 16 {
+        return mask.to_bitmask();
+    }
+
+    let lanes = mask.to_simd();
+    let lanes = lanes.as_array();
+    let mut bits = 0;
+    let mut group = 0;
+    while group < N {
+        let lanes = Simd::<T, 16>::from_slice(&lanes[group..group + 16]);
+        bits |= unsafe { Mask::<T, 16>::from_simd_unchecked(lanes) }.to_bitmask() << group;
+        group += 16;
+    }
+
+    bits
+}
