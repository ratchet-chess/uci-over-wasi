+#ifdef __wasi__
+    // UCI over WASI: the search runs on the UCI thread, so it reads its input here, and maps stop and ponderhit as
+    // UCIEngine::loop does. An infinite or ponder search, or one with no limit, is unbounded.
+    {
+        const auto& l = worker.limits;
+        const bool unbounded = l.infinite || ponder
