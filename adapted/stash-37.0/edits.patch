+static WorkerPool *WasiPool;
+
+// UCI over WASI: whether only a stop ends this go, besides pondering: it is infinite, or it
+// has no limit at all. It is read when the search starts, before it fills in its default
+// depth and nodes.
+static bool WasiUnbounded;
+
+static void wasi_heard(int heard) {
+    if (heard & UCI_STOP) {
+        wpool_stop(WasiPool);
+    }
+
+    if (heard & UCI_PONDERHIT) {
+        wpool_ponderhit(WasiPool);
+    }
+}
+
+void wasi_poll(void) {
+    wasi_heard(uci_poll(WasiUnbounded || wpool_is_pondering(WasiPool)));
+}
+
+void wasi_wait(void) {
+    wasi_heard(uci_wait());
+}
+#endif
