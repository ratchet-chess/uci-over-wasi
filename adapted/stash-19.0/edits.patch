 #include "engine.h"
 #include "uci.h"
+#ifdef __wasi__
+# include "uci_wasi.h"
+
+extern int	wasi_unbounded;
+
+// UCI over WASI: the search runs on the UCI thread, so it reads the input at its
+// periodic check, and acts on it as uci_stop and uci_quit do.
+static void	wasi_heard(int heard)
+{
+	if (heard & UCI_QUIT)
+		uci_quit(NULL);
+	else if (heard & UCI_STOP)
+		uci_stop(NULL);
+}
+
+void		wasi_wait(void)
+{
+	wasi_heard(uci_wait());
+}
+#endif
 
 bool	out_of_time(void)
 {
 	extern uint64_t		g_nodes;
 	extern goparams_t	g_goparams;
 
+#ifdef __wasi__ // UCI over WASI: the input is read here; see wasi_heard
+	wasi_heard(uci_poll(wasi_unbounded));
+#endif
+
 	pthread_mutex_lock(&g_engine_mutex);
 	enum e_egn_send	send = g_engine_send;
 	pthread_mutex_unlock(&g_engine_mutex);
