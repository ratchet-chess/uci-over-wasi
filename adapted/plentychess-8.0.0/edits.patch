 bool timeOver(SearchParameters& parameters, SearchData& data) {
+#ifdef __wasi__
+    // UCI over WASI: the search runs on the UCI thread, so the main thread hears its input here, at its time check.
+    // A stop or a ponderhit stops the search, as the native UCI loop's do. A ponder search, or one with no limit the
+    // search acts on, is unbounded; the search never reads `infinite`, which a bench's depth search has set too.
+    if ((data.nodesSearched.load(std::memory_order_relaxed) % 1024) == 0
+        && (uci_poll(parameters.ponder
+                     || (!parameters.depth && !parameters.nodes && !parameters.movetime && !parameters.wtime
+                         && !parameters.btime))
+            & (UCI_STOP | UCI_PONDERHIT)))
+        return true;
+#endif
     if (parameters.ponder)
         return false;
     return (data.maxTime && (data.nodesSearched.load(std::memory_order_relaxed) % 1024) == 0 && getTime() >= data.maxTime) || (parameters.nodes && data.nodesSearched.load(std::memory_order_relaxed) >= parameters.nodes * (1 + 9 * UCI::Options.datagen.value));
