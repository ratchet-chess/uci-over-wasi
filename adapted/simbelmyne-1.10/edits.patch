+/// UCI over WASI: one thread. The search thread's state and its three commands,
+/// run on the calling thread, the UCI thread.
+#[cfg(target_os = "wasi")]
+struct SearchThread {
+    tt_size: usize,
+    tt: TTable,
+    pawn_cache: PawnCache,
+    history: History,
+}
+
+#[cfg(target_os = "wasi")]
+impl SearchThread {
+    pub fn new() -> Self {
+        Self {
+            tt_size: DEFAULT_TT_SIZE,
+            tt: TTable::with_capacity(DEFAULT_TT_SIZE),
+            pawn_cache: PawnCache::with_capacity(8),
+            history: History::new(),
+        }
+    }
+
+    pub fn search(&mut self, position: Position, mut tc: TimeController) {
+        self.tt.increment_age();
+
+        let report = position.search::<DEBUG>(
+            &mut self.tt,
+            &mut self.pawn_cache,
+            &mut self.history,
+            &mut tc,
+        );
+
+        println!("{}", UciEngineMessage::BestMove(report.pv[0]));
+    }
+
+    pub fn clear_tables(&mut self) {
+        self.history = History::new();
+        self.tt = TTable::with_capacity(self.tt_size);
+    }
+
+    pub fn resize_tt(&mut self, size: usize) {
+        self.tt_size = size;
+        self.tt = TTable::with_capacity(size);
+    }
+}
