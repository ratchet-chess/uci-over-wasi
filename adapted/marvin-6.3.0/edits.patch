+/* UCI over WASI: what uci_check_input does for ponderhit and stop; returns whether to stop */
+static bool engine_wasi_heard(struct search_worker *worker, int heard)
+{
+    if (heard&UCI_PONDERHIT) {
+        tc_allocate_time();
+        worker->engine->pondering = false;
+    }
+    if (heard&UCI_STOP) {
+        worker->engine->pondering = false;
+        return true;
+    }
+    return false;
