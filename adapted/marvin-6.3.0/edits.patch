+     * depth N end by their depth.
+     */
+    if (engine_protocol == PROTOCOL_UCI) {
+        int flags = tc_get_flags();
+        return engine_wasi_heard(worker, uci_poll(worker->engine->pondering ||
+                    ((worker->engine->sd >= MAX_SEARCH_DEPTH) &&
